            "spaced": "/audio/hugo-demain/05-lent.mp3"
          }
        ]
      },
      {
        "text": "J'irai par la forêt, j'irai par la montagne.",
        "segments": [
          {
            "text": "J'irai par la forêt,",
            "audio": "/audio/hugo-demain/06.mp3",
            "spaced": "/audio/hugo-demain/06-lent.mp3"
          },
          {
            "text": "j'irai par la montagne.",
            "audio": "/audio/hugo-demain/07.mp3",
            "spaced": "/audio/hugo-demain/07-lent.mp3"
          }
        ]
      }
