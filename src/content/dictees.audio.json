            "spaced": "/audio/hugo-demain/01-lent.mp3"
          },
          {
            "text": "à l'heure où blanchit la campagne,",
            "audio": "/audio/hugo-demain/02.mp3",
            "spaced": "/audio/hugo-demain/02-lent.mp3"
          },
          {
            "text": "je partirai.",
            "audio": "/audio/hugo-demain/03.mp3",
            "spaced": "/audio/hugo-demain/03-lent.mp3"
          }
        ]
      },
      {
        "text": "Vois-tu, je sais que tu m'attends.",
        "segments": [
          {
            "text": "Vois-tu,",
            "audio": "/audio/hugo-demain/04.mp3",
            "spaced": "/audio/hugo-demain/04-lent.mp3"
