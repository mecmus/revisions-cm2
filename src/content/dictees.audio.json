            "spaced": "/audio/renard-poil/04-lent.mp3"
          }
        ]
      },
      {
        "text": "Là-bas, tout au fond de la grande cour, le petit toit aux poules découpe, dans la nuit, le carré noir de sa porte ouverte.",
        "segments": [
          {
            "text": "Là-bas,",
            "audio": "/audio/renard-poil/05.mp3",
            "spaced": "/audio/renard-poil/05-lent.mp3"
