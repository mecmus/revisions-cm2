  "hugo-demain": {
    "voice": "fr_FR-siwis-medium",
    "full": "/audio/hugo-demain/full.mp3",
    "sentences": [
      {
        "text": "Demain, dès l'aube, à l'heure où blanchit la campagne, je partirai.",
        "segments": [
          {
            "text": "Demain,",
            "audio": "/audio/hugo-demain/00.mp3",
            "spaced": "/audio/hugo-demain/00-lent.mp3"
