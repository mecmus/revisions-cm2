    "full": "/audio/renard-poil/full.mp3",
    "sentences": [
      {
        "text": "Je parie, dit madame Lepic, qu'Honorine a encore oublié de fermer les poules.",
        "segments": [
          {
            "text": "Je parie,",
            "audio": "/audio/renard-poil/00.mp3",
