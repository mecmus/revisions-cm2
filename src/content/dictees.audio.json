    "sentences": [
      {
        "text": "M. Seguin n'avait jamais eu de bonheur avec ses chèvres.",
        "segments": [
          {
            "text": "M. Seguin n'avait jamais eu",
            "audio": "/audio/daudet-chevre/00.mp3",
