            "spaced": "/audio/daudet-chevre/04-lent.mp3"
          },
          {
            "text": "s'en allaient dans la montagne,",
            "audio": "/audio/daudet-chevre/05.mp3",
            "spaced": "/audio/daudet-chevre/05-lent.mp3"
